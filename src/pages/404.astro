---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="This page does not exist.">
  <section class="nf" data-field-window>
    <div class="wrap">
      <h1>Nothing here.</h1>
      <p>The page you asked for does not exist or has moved.</p>
      <a class="text-link" href="/"><Icon name="arrow-left" /> Back to the portfolio</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: flex; align-items: center; }
  .nf .wrap { display: grid; gap: 20px; justify-items: start; }
  h1 {
    font-size: clamp(3rem, 10vw, 9rem);
    font-weight: 160;
    font-stretch: 118%;
    letter-spacing: -0.04em;
  }
  p { font-size: 1.125rem; }
</style>
