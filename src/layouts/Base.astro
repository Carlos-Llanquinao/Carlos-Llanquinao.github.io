---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import SceneBackdrop from '../components/SceneBackdrop.astro';
import Icon from '../components/Icon.astro';
import { profile, links, skills, analytics } from '../data/site';
import { hasTodo } from '../lib/todo.mjs';
// Preload the Latin subsets so headline and body text do not wait for CSS to discover them.
import sansLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** 'profile' on the home page, 'article' on case studies. */
  type?: 'profile' | 'article';
}

const { title, description, type = 'profile' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const fullName = `${profile.firstName} ${profile.lastName}`;

// Structured data so search engines and recruiting tools read the page as a person's profile.
// Links that are still placeholders are left out of `sameAs`.
const sameAs = [links.linkedin, links.github].filter((l) => !hasTodo(l) && l.startsWith('http'));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  jobTitle: profile.headline,
  description: profile.pitch,
  url: new URL('/', Astro.site).toString(),
  image: ogImage.toString(),
  address: { '@type': 'PostalAddress', addressCountry: 'CL' },
  knowsAbout: skills.flatMap((g) => g.items),
  ...(sameAs.length ? { sameAs } : {}),
};

// Cookieless analytics (GoatCounter): only in production builds and only once a code is set.
const goatcounter = import.meta.env.PROD && analytics.goatcounter ? analytics.goatcounter : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full site content for LLMs" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullName} — ${profile.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {goatcounter && (
      <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
    <meta name="theme-color" content="#151413" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f2ee" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      (function () {
        var root = document.documentElement;
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.activeTheme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <SceneBackdrop />
    <Header />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <span>© {new Date().getFullYear()} {profile.firstName} {profile.lastName}</span>
        <span aria-hidden="true">·</span>
        <a href="/llms-full.txt">llms-full.txt</a>
      </div>
    </footer>
    <a class="to-top" href="#top" aria-label="Back to top" data-to-top><Icon name="arrow-up" /></a>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: color-mix(in srgb, var(--card-2) 70%, transparent);
    padding-block: 24px;
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .site-footer__inner { display: flex; justify-content: center; gap: 10px; }
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--btn);
    color: var(--on-btn);
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), background-color 160ms var(--ease-out);
  }
  .to-top :global(svg) { width: 20px; height: 20px; }
  .to-top:hover { background: var(--accent); color: #fff; }
  .to-top.is-visible { opacity: 1; transform: none; pointer-events: auto; }
</style>

<script>
  // Show "back to top" once the first block of the page has scrolled away.
  // An IntersectionObserver avoids reading layout on scroll or during load.
  const toTop = document.querySelector<HTMLElement>('[data-to-top]');
  const first = document.querySelector('main > :first-child');
  if (toTop && first) {
    new IntersectionObserver(([entry]) => toTop.classList.toggle('is-visible', !entry.isIntersecting)).observe(first);
  }
</script>
