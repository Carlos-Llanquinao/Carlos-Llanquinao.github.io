---
/**
 * Renders a content string. Placeholders ([TODO: ...], [SURNAME]) become hazard-styled
 * <mark class="todo">, and `backtick` spans become <code>. Use for every content string.
 */
import { splitTodo } from '../lib/todo.mjs';

interface Props {
  text: string;
}

const { text = '' } = Astro.props;
const parts = splitTodo(text);
const withCode = (s: string) =>
  s.split(/(`[^`]+`)/).map((piece) =>
    piece.startsWith('`') && piece.endsWith('`') && piece.length > 1 ? { code: piece.slice(1, -1) } : { plain: piece },
  );
---
{parts.map((p) =>
  p.todo ? (
    <mark class="todo">{p.text}</mark>
  ) : (
    withCode(p.text).map((c) => ('code' in c ? <code>{c.code}</code> : c.plain))
  ),
)}
