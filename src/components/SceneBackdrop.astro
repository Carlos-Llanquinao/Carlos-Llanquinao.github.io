---
/**
 * Page backdrop: the site is a Unity scene. Default primitives (Cube, Sphere, Capsule,
 * Cylinder), the Main Camera frustum and the Directional Light gizmo float as slowly rotating
 * wireframes in the empty space beside each section heading; the first cube is "selected"
 * (orange outline + move tool), as in the editor.
 *
 * Canvas 2D, a few hundred line segments per frame. Hidden on screens under 900px where
 * headings span the full width. Animation stops when the tab is hidden; under
 * prefers-reduced-motion a single still frame is drawn per scroll.
 */
---
<canvas id="scene-backdrop" aria-hidden="true"></canvas>

<style>
  #scene-backdrop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  type V3 = [number, number, number];
  type Seg = [V3, V3];
  type Kind = 'cube' | 'sphere' | 'capsule' | 'cylinder' | 'camera' | 'light';
  interface Obj {
    kind: Kind;
    size: number;
    spin: number;
    tilt: number;
    phase: number;
    selected?: boolean;
  }

  const canvas = document.getElementById('scene-backdrop') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  // ---------- Geometry (unit size, centred on origin) ----------
  const ring = (r: number, y: number, n = 24, axis: 'y' | 'x' = 'y'): Seg[] => {
    const out: Seg[] = [];
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2, b = ((i + 1) / n) * Math.PI * 2;
      const p = (t: number): V3 => (axis === 'y' ? [Math.cos(t) * r, y, Math.sin(t) * r] : [y, Math.cos(t) * r, Math.sin(t) * r]);
      out.push([p(a), p(b)]);
    }
    return out;
  };
  const meridian = (r: number, angle: number, from = 0, to = Math.PI, yOff = 0, n = 12): Seg[] => {
    const out: Seg[] = [];
    for (let i = 0; i < n; i++) {
      const a = from + ((to - from) * i) / n, b = from + ((to - from) * (i + 1)) / n;
      const p = (t: number): V3 => [Math.sin(t) * Math.cos(angle) * r, Math.cos(t) * r + yOff, Math.sin(t) * Math.sin(angle) * r];
      out.push([p(a), p(b)]);
    }
    return out;
  };

  const cube = (): Seg[] => {
    const v = (x: number, y: number, z: number): V3 => [x * 0.5, y * 0.5, z * 0.5];
    const e: Seg[] = [];
    for (const s of [-1, 1]) {
      e.push([v(-1, s, -1), v(1, s, -1)], [v(1, s, -1), v(1, s, 1)], [v(1, s, 1), v(-1, s, 1)], [v(-1, s, 1), v(-1, s, -1)]);
    }
    for (const [x, z] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) e.push([v(x, -1, z), v(x, 1, z)]);
    return e;
  };
  const sphere = (): Seg[] => {
    const e: Seg[] = [];
    for (const y of [-0.35, 0, 0.35]) e.push(...ring(Math.sqrt(0.25 - y * y), y));
    for (let i = 0; i < 4; i++) e.push(...meridian(0.5, (i / 4) * Math.PI, 0, Math.PI * 2, 0, 24));
    return e;
  };
  const capsule = (): Seg[] => {
    const r = 0.3, h = 0.4;
    const e: Seg[] = [...ring(r, h), ...ring(r, -h), ...ring(r, 0, 20)];
    for (let i = 0; i < 4; i++) {
      const a = (i / 4) * Math.PI * 2;
      e.push([[Math.cos(a) * r, h, Math.sin(a) * r], [Math.cos(a) * r, -h, Math.sin(a) * r]]);
    }
    for (let i = 0; i < 2; i++) {
      e.push(...meridian(r, (i / 2) * Math.PI, -Math.PI / 2, Math.PI / 2, h, 8));
      e.push(...meridian(r, (i / 2) * Math.PI, Math.PI / 2, (Math.PI * 3) / 2, -h, 8));
    }
    return e;
  };
  const cylinder = (): Seg[] => {
    const r = 0.4, h = 0.5;
    const e: Seg[] = [...ring(r, h), ...ring(r, -h)];
    for (let i = 0; i < 6; i++) {
      const a = (i / 6) * Math.PI * 2;
      e.push([[Math.cos(a) * r, h, Math.sin(a) * r], [Math.cos(a) * r, -h, Math.sin(a) * r]]);
    }
    return e;
  };
  const camera = (): Seg[] => {
    // Frustum: eye at the back, near and far planes forward along +z.
    const e: Seg[] = [];
    const plane = (z: number, w: number, hh: number): V3[] => [[-w, -hh, z], [w, -hh, z], [w, hh, z], [-w, hh, z]];
    const near = plane(-0.1, 0.12, 0.08), far = plane(0.6, 0.5, 0.32);
    for (const pl of [near, far]) for (let i = 0; i < 4; i++) e.push([pl[i], pl[(i + 1) % 4]]);
    for (let i = 0; i < 4; i++) e.push([near[i], far[i]]);
    // Camera body
    const body = cube().map(([a, b]) => [[a[0] * 0.36, a[1] * 0.28, a[2] * 0.42 - 0.38], [b[0] * 0.36, b[1] * 0.28, b[2] * 0.42 - 0.38]] as Seg);
    return [...e, ...body];
  };
  const light = (): Seg[] => {
    // Directional light gizmo: a disc with parallel rays.
    const e: Seg[] = [...ring(0.22, 0, 16, 'x')];
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2;
      const y = Math.cos(a) * 0.22, z = Math.sin(a) * 0.22;
      e.push([[0, y, z], [0.7, y, z]]);
    }
    return e;
  };
  const MESH: Record<Kind, Seg[]> = { cube: cube(), sphere: sphere(), capsule: capsule(), cylinder: cylinder(), camera: camera(), light: light() };
  const LABEL: Partial<Record<Kind, string>> = { camera: 'Main Camera', light: 'Directional Light' };

  // ---------- Scene layout ----------
  // One object per section heading, placed in the empty space to the right of it.
  const OBJECTS: Obj[] = [
    { kind: 'cube', size: 110, spin: 0.12, tilt: 0.55, phase: 0.3, selected: true },
    { kind: 'camera', size: 140, spin: 0.07, tilt: 0.25, phase: 0.9 },
    { kind: 'sphere', size: 125, spin: 0.1, tilt: 0.35, phase: 1.2 },
    { kind: 'light', size: 120, spin: 0.08, tilt: 0.5, phase: 0.6 },
    { kind: 'capsule', size: 130, spin: 0.09, tilt: 0.3, phase: 2.1 },
    { kind: 'cylinder', size: 110, spin: 0.11, tilt: 0.5, phase: 1.7 },
  ];
  let slots: { x: number; y: number }[] = [];
  const measure = () => {
    slots = [...document.querySelectorAll<HTMLElement>('.section-head')].map((head) => {
      const r = head.getBoundingClientRect();
      const wrap = (head.closest('.wrap') as HTMLElement | null)?.getBoundingClientRect() ?? r;
      return { x: wrap.right - Math.min(190, wrap.width * 0.16), y: r.top + scrollY + r.height / 2 };
    });
  };

  if (canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let W = 0, H = 0, DPR = 1;
    let ink = '#16181d', sel = '#f28c28', ax = ['#d9443a', '#3f9a3d', '#3a6be0'], alpha = 0.16;
    let raf = 0, last = 0, t = 0;

    const readTheme = () => {
      const cs = getComputedStyle(document.documentElement);
      ink = cs.getPropertyValue('--ink').trim() || ink;
      ax = ['--axis-x', '--axis-y', '--axis-z'].map((v, i) => cs.getPropertyValue(v).trim() || ax[i]);
      alpha = document.documentElement.dataset.activeTheme === 'dark' ? 0.2 : 0.16;
    };
    const resize = () => {
      DPR = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
      measure();
    };

    const rot = (p: V3, ry: number, rx: number): V3 => {
      const [x, y, z] = p;
      const cy = Math.cos(ry), sy = Math.sin(ry), cx = Math.cos(rx), sx = Math.sin(rx);
      const x1 = x * cy + z * sy, z1 = -x * sy + z * cy;
      return [x1, y * cx - z1 * sx, y * sx + z1 * cx];
    };
    const project = (p: V3, s: number, ox: number, oy: number): [number, number] => {
      const f = 3.2 / (3.2 + p[2]);
      return [ox + p[0] * s * f, oy - p[1] * s * f];
    };

    const draw = () => {
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.clearRect(0, 0, W, H);
      // Section headings span the full width on narrow screens: no free space, no objects.
      if (W < 900) return;
      const narrow = false;
      const scale = W < 1180 ? 0.8 : 1;
      for (let i = 0; i < slots.length; i++) {
        const o = OBJECTS[i % OBJECTS.length];
        const s = o.size * scale;
        // Gentle float, like an object hovering in the Scene view.
        const y = slots[i].y - scrollY + Math.sin(t * 0.7 + i) * 5;
        if (y < -s * 2 || y > H + s * 2) continue;
        const x = slots[i].x;
        const ry = o.phase + t * o.spin;
        const rx = o.tilt;
        const segs = MESH[o.kind];
        ctx.lineWidth = 1.25;
        ctx.lineCap = 'round';
        ctx.globalAlpha = o.selected ? alpha * 3.2 : alpha;
        ctx.strokeStyle = o.selected ? sel : ink;
        ctx.beginPath();
        for (const [a, b] of segs) {
          const [ax0, ay0] = project(rot(a, ry, rx), s, x, y);
          const [bx0, by0] = project(rot(b, ry, rx), s, x, y);
          ctx.moveTo(ax0, ay0); ctx.lineTo(bx0, by0);
        }
        ctx.stroke();
        if (o.selected) {
          // Move tool: world-space X/Y/Z handles from the pivot.
          const dirs: V3[] = [[0.85, 0, 0], [0, 0.85, 0], [0, 0, 0.85]];
          dirs.forEach((d, i) => {
            const [ex, ey] = project(rot(d, ry * 0.15, rx), s, x, y);
            ctx.globalAlpha = Math.min(1, alpha * 4.5);
            ctx.strokeStyle = ax[i];
            ctx.fillStyle = ax[i];
            ctx.lineWidth = 2;
            ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(ex, ey); ctx.stroke();
            ctx.beginPath(); ctx.arc(ex, ey, 3.5, 0, Math.PI * 2); ctx.fill();
          });
        }
        const label = LABEL[o.kind];
        if (label && !narrow) {
          ctx.globalAlpha = alpha * 3;
          ctx.fillStyle = ink;
          ctx.font = '600 11px "Archivo Variable", system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(label, x, y + s * 0.62);
        }
      }
      ctx.globalAlpha = 1;
    };

    const frame = (now: number) => {
      raf = 0;
      if (document.hidden || reduce.matches) return;
      t += Math.min(0.05, (now - (last || now)) / 1000);
      last = now;
      draw();
      raf = requestAnimationFrame(frame);
    };
    const kick = () => {
      if (reduce.matches) { draw(); return; }
      if (!raf && !document.hidden) { last = 0; raf = requestAnimationFrame(frame); }
    };

    // Start once the browser is idle, so measuring headings never competes with the first render.
    const start = () => { resize(); readTheme(); draw(); kick(); };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 200);
    addEventListener('resize', () => { resize(); draw(); });
    addEventListener('scroll', () => { if (reduce.matches) draw(); }, { passive: true });
    addEventListener('load', () => { resize(); draw(); });
    // Headings move when fonts load or content reflows; keep the slots in sync.
    new ResizeObserver(() => { measure(); draw(); }).observe(document.body);
    document.addEventListener('visibilitychange', kick);
    reduce.addEventListener('change', kick);
    new MutationObserver(() => { readTheme(); draw(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-active-theme'] });
  }
</script>
