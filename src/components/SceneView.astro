---
/**
 * Decorative backdrop for hero panels, borrowed from the Unity editor's Scene view:
 * a tab strip with an axis gizmo, and an infinite perspective ground grid with the red X and
 * blue Z axes. The grid dollies slowly and tilts a few degrees with the pointer, like orbiting
 * the Scene camera. Pure CSS + ~20 lines of JS; static under prefers-reduced-motion.
 * Place inside a positioned container marked with [data-scene-host].
 */
interface Props {
  label?: string;
}
const { label = 'Scene' } = Astro.props;
---
<div class="scene-bar" aria-hidden="true">
  <span class="scene-tab scene-tab--active">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
      <path d="M8 1.8 13.5 5v6L8 14.2 2.5 11V5z" /><path d="M2.5 5 8 8.2 13.5 5M8 8.2v6" />
    </svg>
    {label}
  </span>
  <svg class="gizmo" viewBox="0 0 44 44" fill="none" stroke-linecap="round">
    <line x1="22" y1="22" x2="37" y2="26" stroke="var(--axis-x)" stroke-width="2.2" />
    <line x1="22" y1="22" x2="22" y2="6" stroke="var(--axis-y)" stroke-width="2.2" />
    <line x1="22" y1="22" x2="10" y2="31" stroke="var(--axis-z)" stroke-width="2.2" />
    <circle cx="37" cy="26" r="3.6" fill="var(--axis-x)" />
    <circle cx="22" cy="6" r="3.6" fill="var(--axis-y)" />
    <circle cx="10" cy="31" r="3.6" fill="var(--axis-z)" />
    <rect x="18.5" y="18.5" width="7" height="7" rx="1.2" fill="var(--ink-3)" />
    <text x="41" y="35" fill="var(--axis-x)">x</text>
    <text x="27" y="8" fill="var(--axis-y)">y</text>
    <text x="3" y="41" fill="var(--axis-z)">z</text>
  </svg>
</div>
<div class="scene" aria-hidden="true">
  <div class="scene__floor"></div>
</div>

<style>
  .scene-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 40px;
    padding-inline: 10px 8px;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--card-2) 80%, transparent);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-3);
    user-select: none;
  }
  .scene-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding-inline: 10px;
    border-radius: 8px;
  }
  .scene-tab svg { width: 14px; height: 14px; }
  .scene-tab--active { background: var(--card); color: var(--ink-2); box-shadow: var(--shadow-sm); }
  .gizmo { width: 36px; height: 36px; margin-left: auto; overflow: visible; }
  .gizmo text { font: 700 8px var(--sans); }

  .scene {
    position: absolute;
    inset: 40px 0 0 0;
    overflow: hidden;
    perspective: 760px;
    perspective-origin: 50% 0%;
    pointer-events: none;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .scene__floor {
    --minor: color-mix(in srgb, var(--ink) 9%, transparent);
    --major: color-mix(in srgb, var(--ink) 16%, transparent);
    position: absolute;
    left: -60%;
    right: -60%;
    /* The ground always occupies the lower part of the panel, below the copy. */
    top: var(--floor-top, max(40%, calc(100% - 300px)));
    height: 180%;
    transform-origin: 50% 0;
    transform: rotateX(calc(74deg + var(--tilt-x, 0deg))) rotateZ(var(--tilt-z, 0deg));
    transition: transform 900ms var(--ease-out);
    background-image:
      linear-gradient(var(--major) 1.5px, transparent 1.5px),
      linear-gradient(90deg, var(--major) 1.5px, transparent 1.5px),
      linear-gradient(var(--minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--minor) 1px, transparent 1px);
    background-size: 240px 240px, 240px 240px, 48px 48px, 48px 48px;
    background-position: 50% 0;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 55%, transparent 92%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 55%, transparent 92%);
    animation: dolly 24s linear infinite;
  }
  /* World axes: red X across, blue Z into depth. */
  .scene__floor::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent calc(50% - 1.5px), var(--axis-z) calc(50% - 1.5px), var(--axis-z) calc(50% + 1.5px), transparent calc(50% + 1.5px)),
      linear-gradient(transparent calc(18% - 1.5px), var(--axis-x) calc(18% - 1.5px), var(--axis-x) calc(18% + 1.5px), transparent calc(18% + 1.5px));
    opacity: 0.4;
  }
  @keyframes dolly {
    from { background-position: 50% 0; }
    to { background-position: 50% 240px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene__floor { animation: none; transition: none; }
  }
</style>

<script>
  // Orbit: tilt the ground grid a few degrees toward the pointer, eased by CSS.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-scene-host]').forEach((host) => {
    const floor = host.querySelector<HTMLElement>('.scene__floor');
    if (!floor) return;
    host.addEventListener('pointermove', (e) => {
      if (reduce.matches || e.pointerType === 'touch') return;
      const r = host.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      floor.style.setProperty('--tilt-z', `${(-nx * 8).toFixed(2)}deg`);
      floor.style.setProperty('--tilt-x', `${(ny * 5).toFixed(2)}deg`);
    });
    host.addEventListener('pointerleave', () => {
      floor.style.setProperty('--tilt-z', '0deg');
      floor.style.setProperty('--tilt-x', '0deg');
    });
  });
</script>
